{
  "name": "@statewalker/indexer-ngram",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "N-gram / regex (grep) modality contract for @statewalker/indexer-api: types, typed access handle and a grep helper.",
  "bugs": {
    "url": "https://github.com/statewalker/statewalker-search/issues"
  },
  "homepage": "https://github.com/statewalker/statewalker-search/tree/main/packages/indexer-ngram#readme",
  "author": {
    "name": "Mikhail Kotelnikov",
    "email": "mikhail.kotelnikov@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statewalker/statewalker-search.git",
    "directory": "packages/indexer-ngram"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "lint": "biome check --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@statewalker/indexer-api": "workspace:^"
  },
  "devDependencies": {
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
