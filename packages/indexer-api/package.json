{
  "name": "@statewalker/indexer-api",
  "version": "0.1.3",
  "private": false,
  "type": "module",
  "description": "Backend-agnostic indexer contract: Indexer, Index as a registry of named sub-indexes, RRF search, persistence types.",
  "bugs": {
    "url": "https://github.com/statewalker/statewalker-search/issues"
  },
  "homepage": "https://github.com/statewalker/statewalker-search/tree/main/packages/indexer-api#readme",
  "author": {
    "name": "Mikhail Kotelnikov",
    "email": "mikhail.kotelnikov@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statewalker/statewalker-search.git",
    "directory": "packages/indexer-api"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "lint": "biome check --write .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
