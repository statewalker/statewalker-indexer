{
  "name": "@statewalker/indexer-tests",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared test suite for @statewalker/indexer-* implementations. Internal dev-only; not published.",
  "bugs": {
    "url": "https://github.com/statewalker/statewalker-search/issues"
  },
  "homepage": "https://github.com/statewalker/statewalker-search/tree/main/packages/indexer-tests#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statewalker/statewalker-search.git",
    "directory": "packages/indexer-tests"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "lint": "biome check --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@statewalker/indexer-api": "workspace:^",
    "@statewalker/indexer-fulltext": "workspace:^",
    "@statewalker/indexer-ngram": "workspace:^",
    "@statewalker/indexer-search": "workspace:^",
    "@statewalker/indexer-vector": "workspace:^"
  },
  "peerDependencies": {
    "vitest": "catalog:peers"
  },
  "devDependencies": {
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
